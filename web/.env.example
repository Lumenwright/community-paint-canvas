# Supabase (server-only — never expose service role key to the client)
SUPABASE_URL=http://127.0.0.1:44321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (public — safe to expose, used for Realtime subscriptions)
PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Twitch Extension (server-only)
# Extension Client ID from Twitch Developer Console
TWITCH_EXTENSION_CLIENT_ID=placeholder_extension_client_id
# Extension Secret (base64-encoded) from Twitch Developer Console
TWITCH_EXTENSION_SECRET=placeholder_extension_secret_base64

# Twitch OAuth (PKCE flow for drawing site + mod login)
TWITCH_CLIENT_ID=placeholder_twitch_client_id
TWITCH_CLIENT_SECRET=placeholder_twitch_client_secret

# Signing secret for session cookies and ext-handoff tokens
SESSION_SECRET=replace_with_32plus_random_chars

# The broadcaster's Twitch user ID — grants broadcaster-level API access
BROADCASTER_TWITCH_ID=placeholder_broadcaster_id

# Secret that Vercel Cron must send in the Authorization header
CRON_SECRET=replace_with_random_secret

# Public URLs (used in Extension to link back to this site)
PUBLIC_EBS_URL=http://localhost:5173
PUBLIC_DRAWING_SITE_URL=http://localhost:5173

# Set to "true" to allow test_ prefixed Bits transaction IDs (dev/test only)
PUBLIC_DEV_MODE=true
